<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" ya no cubre la transferencia entre
     dispositivos; se excluye explícitamente todo (base Isar con datos de
     clientes y el almacén cifrado del token, cuya clave del Keystore no viaja). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
