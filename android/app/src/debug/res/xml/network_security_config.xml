<?xml version="1.0" encoding="utf-8"?>
<!-- Solo builds debug (sustituye al de src/main): permite HTTP para probar
     contra un FacturaScripts local. En release la app exige HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
