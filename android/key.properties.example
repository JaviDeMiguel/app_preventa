# Copia este archivo como android/key.properties (ignorado por git) y rellénalo.
# Generar el keystore (guárdalo FUERA del repositorio y haz copia de seguridad:
# si se pierde no podrás publicar actualizaciones de la app):
#   keytool -genkey -v -keystore ~/preventa-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=CAMBIAR
keyPassword=CAMBIAR
keyAlias=upload
storeFile=C:/ruta/fuera/del/repo/preventa-upload.jks
